<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>compileBitcode</key>
	<false/>
	<key>method</key>
	<string>ad-hoc</string> <!-- Change to "app-store" for TestFlight/AppStore releases -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>teamID</key>
	<string>YOUR_APPLE_TEAM_ID</string> <!-- Replace with your 10-character Apple Developer Team ID -->
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
